// Signierung. Voreinstellung: ad-hoc, damit ein frischer Klon ohne
// Apple-Konto baut. Fuer eine stabile Accessibility-Freigabe eine eigene
// Team-ID eintragen — siehe README, Abschnitt "Signierung einrichten".

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// Lokale Ueberschreibung, liegt nicht im Repo. Fehlt sie, wird diese Zeile
// stillschweigend uebersprungen ("?" macht den Include optional).
#include? "Signing.local.xcconfig"
